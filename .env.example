# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...
PORT=3000
# Optional: enables image generation on the Social tab (Gemini image model)
GEMINI_API_KEY=

# Optional tools (see docs/build/07-tooling.md). All degrade gracefully when unset.
JINA_API_KEY=
LANGUAGETOOL_URL=
PEXELS_API_KEY=

# Phase 1 (web/): Firebase + single-user auth. Absent = in-memory store, which
# is what the test suites and mock mode use.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_STORAGE_BUCKET=
ALLOWED_EMAIL=
ALLOWED_UID=owner
MOCK_AUTH=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=
