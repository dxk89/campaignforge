# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...
PORT=3000
# Optional: enables image generation on the Social tab (Gemini image model)
GEMINI_API_KEY=

# Optional tools (see docs/build/07-tooling.md). All degrade gracefully when unset.
JINA_API_KEY=
LANGUAGETOOL_URL=
PEXELS_API_KEY=

# Phase 1 (web/): Firebase + single-user auth. Absent = in-memory store, which
# is what the test suites and mock mode use.
# Paste the service account JSON whole, or base64 of it. Both are accepted.
FIREBASE_SERVICE_ACCOUNT=

# Object storage: Cloudflare R2 (S3-compatible). Uploads, brand assets,
# generated images and claim evidence. Absent = in-memory, which is what the
# test suites use. Required whenever FIREBASE_SERVICE_ACCOUNT is set, or a
# deployment would accept uploads and lose them on the next cold start.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
ALLOWED_EMAIL=
ALLOWED_UID=owner
MOCK_AUTH=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=
