rules_version = '2';
// All access is server-side through the Admin SDK, which bypasses these rules
// entirely. Workspace isolation is enforced in application code, by the ws
// parameter threaded through web/server. These rules exist only to ensure no
// browser can reach Firestore directly.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { allow read, write: if false; }
  }
}
